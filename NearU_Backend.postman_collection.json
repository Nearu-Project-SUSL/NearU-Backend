        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"user_{{$timestamp}}\",\n  \"email\": \"user_{{$timestamp}}@test.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Student\",\n  \"mobileNumber\": \"0771234567\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200 or 201\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                                    "});",
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data) {",
                                    "    try {",
                                    "        var reqBody = JSON.parse(pm.request.body.raw);",
                                    "        pm.collectionVariables.set(\"registeredEmail\", reqBody.email);",
                                    "    } catch (e) {}",
                                    "    if (jsonData.data.userId) {",
                                    "        pm.collectionVariables.set(\"userId\", jsonData.data.userId);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Status code is 200\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
                                    "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                                    "    pm.collectionVariables.set(\"refreshToken\", jsonData.data.refreshToken);",
                                    "    if (jsonData.data.userId) {",
                                    "        pm.collectionVariables.set(\"userId\", jsonData.data.userId);",
